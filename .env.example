# Napture Browser - Optional Environment Configurations

# Release channel (e.g. stable, beta, nightly)
NAPTURE_CHANNEL=stable

# Optional custom telemetry server endpoint (leave empty or unset to disable)
# TELEMETRY_ENDPOINT=https://telemetry.yourdomain.com/v1/report

# Optional custom sync server endpoint
# SYNC_SERVER_URL=https://sync.yourdomain.com

# Optional git commit hash tag
# GIT_COMMIT_HASH=
