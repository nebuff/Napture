# @ghostery/adblocker-electron declares `peer electron ">11"`, which npm cannot
# satisfy with electron 46.0.0-alpha.13: a prerelease never matches a plain
# comparator range, so `npm ci` aborted with ERESOLVE in CI while local installs
# worked because they passed --legacy-peer-deps by hand.
#
# The dependency tree is fine once installed; make the flag the default so
# `npm ci` and `npm install` resolve identically on CI and locally.
legacy-peer-deps=true
